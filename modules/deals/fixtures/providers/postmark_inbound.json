    "MailboxHash": "pmthread7",
    "Headers": [
      {
        "Name": "In-Reply-To",
        "Value": "<deal-thread@example.com>"
      }
    ]
  },
  "expected_subset": {
    "source": "postmark",
    "from": "legal@example.com",
    "to": [
      "deals+pmthread7@example.com"
    ],
    "cc": [
      "ops@example.com"
    ],
    "subject": "Re: Security Addendum",
    "text": "Please send the final signed copy.",
    "html": "<p>Please send the final signed copy.</p>",
    "message_id": "<postmark-inbound@example.com>",
    "in_reply_to": "<deal-thread@example.com>",
