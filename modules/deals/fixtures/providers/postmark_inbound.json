  "kind": "inbound",
  "provider": "postmark",
  "input": {
    "From": "Legal <legal@example.com>",
    "FromFull": {
      "Email": "legal@example.com",
      "Name": "Legal"
    },
    "ToFull": [
      {
        "Email": "deals+pmthread7@example.com",
        "Name": "Deals"
      }
    ],
    "CcFull": [
      {
        "Email": "ops@example.com",
        "Name": "Ops"
      }
    ],
    "Subject": "Re: Security Addendum",
    "TextBody": "Please send the final signed copy.",
    "HtmlBody": "<p>Please send the final signed copy.</p>",
